{
  "model": {
    "type": "select",
    "property": "item_models:test",
    "cases": [
      {
        "model":{
          "type": "model",
          "model": "item/blaze_rod"
        },
        "when": [ "creative" ]
      },
      {
        "model": {
          "type": "model",
          "model": "item/breeze_rod"
        },
        "when": [ "adventure" ]
      }
    ],
    "fallback": {
      "type": "model",
      "model": "item/stick"
    }
  }
}